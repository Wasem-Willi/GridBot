MODE=paper
BINANCE_API_KEY=replace_me
BINANCE_API_SECRET=replace_me
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

CAPITAL_USDT=200
DAILY_LOSS_LIMIT_PCT=0.05
PER_SYMBOL_STOP_LOSS_PCT=0.03
PER_SYMBOL_TAKE_PROFIT_PCT=0.04

GRID_SPACING_PCT=0.006
GRID_LEVELS=8
SYMBOL_REFRESH_MINUTES=60
LOOP_SECONDS=60
COMMAND_POLL_SECONDS=5
INSUFFICIENT_FUNDS_RETRY_MINUTES=10
RECONCILIATION_ENABLED=true
RECONCILIATION_QTY_DRIFT_PCT=0.001
RECONCILIATION_EQUITY_DRIFT_USDT=5
RECONCILIATION_CLEAN_CYCLES_REQUIRED=3
RECONCILIATION_CHECK_ON_HALT=true
MAX_ACTIVE_SYMBOLS=5
MAX_SYMBOL_CAPITAL_PCT=0.20

# AI regime filter (per-symbol ranging-vs-trending classifier).
# Mode: off (disabled) | shadow (log verdicts, do not act) | active (pause/block).
REGIME_FILTER_MODE=shadow
REGIME_ADX_ENTER=25
REGIME_ADX_EXIT=18
REGIME_HURST_ENTER=0.55
REGIME_HURST_EXIT=0.50
REGIME_MIN_VOL_PCT=0.05
REGIME_MAX_VOL_PCT=5.0
REGIME_RECOMPUTE_SECONDS=300
REGIME_KLINE_INTERVAL=15m
REGIME_KLINE_LOOKBACK=96

# Generative AI filter (OpenAI).
# Mode: off (disabled) | shadow (log only) | active (acts on decisions).
AI_FILTER_MODE=off
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace_me
# Path to the markdown/system prompt used by the OpenAI decision client.
AI_PROMPT_PATH=docs/openai-decision-spec.md
AI_TIMEOUT_SECONDS=2
AI_RECOMPUTE_SECONDS=300
# Timeout for the interactive /ask Telegram command (separate from the
# per-cycle decision timeout above, since a chat answer can take longer).
AI_CHAT_TIMEOUT_SECONDS=20

# Optional override; if omitted, defaults by MODE:
# paper/live -> https://api.binance.com
# testnet    -> https://testnet.binance.vision
# BINANCE_BASE_URL=https://api.binance.com
# For MODE=testnet, do NOT leave this set to api.binance.com.
TIMEZONE=Asia/Jerusalem
DB_PATH=data/gridbot.db
BLACKLIST_PATH=config/blacklist.txt

# Live Telegram notification toggles (per action type). All default to true;
# set any to false to silence that category without disabling the underlying
# behavior. Control-command replies (/status, /pnl, /kill, /resume, etc.)
# always send regardless of these flags.
NOTIFY_AI_DECISIONS=true
NOTIFY_REGIME=true
NOTIFY_LIQUIDATION=true
NOTIFY_ORDER_ERRORS=true
NOTIFY_RISK_HALTS=true
NOTIFY_SYMBOL_REFRESH=true
NOTIFY_DAILY_SUMMARY=true
